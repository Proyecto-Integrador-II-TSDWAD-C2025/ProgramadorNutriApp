<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MiPlanAlimenticioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_plan_alimenticio"
            android:textColor="@color/text_heading"
            android:fontFamily="@font/inter_bold"
            android:textSize="24sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_plan_alimenticio"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter_regular"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tag_desayuno"
            android:textColor="@color/primary"
            android:fontFamily="@font/inter_medium"
            android:textSize="13sp"
            android:background="@drawable/tag_fondo"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_fondo"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comida_desayuno"
                android:textColor="@color/text_heading"
                android:fontFamily="@font/inter_semibold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_desayuno"
                android:textColor="@color/text_body"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tag_almuerzo"
            android:textColor="@color/primary"
            android:fontFamily="@font/inter_medium"
            android:textSize="13sp"
            android:background="@drawable/tag_fondo"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_fondo"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comida_almuerzo"
                android:textColor="@color/text_heading"
                android:fontFamily="@font/inter_semibold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_almuerzo"
                android:textColor="@color/text_body"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tag_merienda"
            android:textColor="@color/primary"
            android:fontFamily="@font/inter_medium"
            android:textSize="13sp"
            android:background="@drawable/tag_fondo"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_fondo"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comida_merienda"
                android:textColor="@color/text_heading"
                android:fontFamily="@font/inter_semibold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_merienda"
                android:textColor="@color/text_body"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tag_cena"
            android:textColor="@color/primary"
            android:fontFamily="@font/inter_medium"
            android:textSize="13sp"
            android:background="@drawable/tag_fondo"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_fondo"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comida_cena"
                android:textColor="@color/text_heading"
                android:fontFamily="@font/inter_semibold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_cena"
                android:textColor="@color/text_body"
                android:fontFamily="@font/inter_regular"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>